<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_noir"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar Perfil"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Edita tu nombre"
        android:textColor="@color/text_secondary_noir"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_bar"
        android:hint="Tu nombre"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary_noir" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Edita tu contraseña"
        android:textColor="@color/text_secondary_noir"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etEditPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_bar"
        android:hint="Tu nueva contraseña"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary_noir" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Confirma tu nueva contraseña"
        android:textColor="@color/text_secondary_noir"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etConfirmNewPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_bar"
        android:hint="Confirma tu contraseña"
        android:inputType="textPassword"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary_noir" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="CANCELAR"
            android:textColor="@color/text_secondary_noir"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"/>

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent_noir"
            android:text="GUARDAR"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>