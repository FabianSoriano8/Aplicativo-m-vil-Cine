<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.appcineindie.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_reviewsFragment"
            app:destination="@id/reviewsFragment" />
        <action
            android:id="@+id/action_loginFragment_to_userTypeFragment"
            app:destination="@id/userTypeFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.appcineindie.login.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_userTypeFragment"
            app:destination="@id/userTypeFragment" />
    </fragment>

    <fragment
        android:id="@+id/userTypeFragment"
        android:name="com.example.appcineindie.login.UserTypeFragment"
        android:label="User Type"
        tools:layout="@layout/activity_usertype" >
        <action
            android:id="@+id/action_userTypeFragment_to_reviewsFragment"
            app:destination="@id/reviewsFragment" />
        <action
            android:id="@+id/action_userTypeFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.appcineindie.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/reviewsFragment"
        android:name="com.example.appcineindie.ui.ReviewsFragment"
        android:label="Reviews"
        tools:layout="@layout/fragment_reviews" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.appcineindie.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/movieDetailFragment"
        android:name="com.example.appcineindie.ui.MovieDetailFragment"
        android:label="Movie Detail"
        tools:layout="@layout/fragment_movie_detail">
        <argument
            android:name="movieId"
            app:argType="string" />
        <action
            android:id="@+id/action_movieDetailFragment_to_videoPlayerFragment"
            app:destination="@id/videoPlayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/videoPlayerFragment"
        android:name="com.example.appcineindie.ui.VideoPlayerFragment"
        android:label="Video Player"
        tools:layout="@layout/fragment_video_player">
        <argument
            android:name="videoUrl"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.appcineindie.ui.SearchFragment"
        android:label="Search"
        tools:layout="@layout/fragment_search" />

    <!-- Admin Destinations -->
    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.appcineindie.ui.admin.AdminDashboardFragment"
        android:label="Admin Dashboard"
        tools:layout="@layout/fragment_admin_dashboard" />

    <fragment
        android:id="@+id/adminMoviesFragment"
        android:name="com.example.appcineindie.ui.admin.AdminMoviesFragment"
        android:label="Manage Movies"
        tools:layout="@layout/fragment_admin_movies" />

    <fragment
        android:id="@+id/adminReviewsFragment"
        android:name="com.example.appcineindie.ui.admin.AdminReviewsFragment"
        android:label="Manage Reviews"
        tools:layout="@layout/fragment_admin_reviews" />

    <fragment
        android:id="@+id/adminUsersFragment"
        android:name="com.example.appcineindie.ui.admin.AdminUsersFragment"
        android:label="Manage Users"
        tools:layout="@layout/fragment_admin_users" />

</navigation>
